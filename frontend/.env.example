# Firebase configuration.
#
# Copy this file to .env and supply values from your own Firebase project
# (Firebase console -> Project settings -> Your apps -> SDK setup).
#
# The Firebase project used during development belonged to a team member and
# has been decommissioned. Supply your own project to run authentication and
# the profile page; everything else works without it.
#
# .env is gitignored. Keep it that way: values committed to git history cannot
# be removed without rewriting published commits.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional, for Google Analytics
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Base URL of the Flask inference API
REACT_APP_API_URL=http://127.0.0.1:5001
